<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
</head>
<body style="margin:0;font-family:arial;line-height:1.6">
    <table style="border:0;width:100%;max-width:600px;margin:0 auto;border-collapse:collapse">
        <tr style="background:#2563eb">
            <td style="padding:24px;color:#ffffff;text-align:center;font-size:22px;font-weight:700">
                {{app_name}} - New Worker Review
            </td>
        </tr>
        <tr>
            <td style="padding:24px;color:#374151;font-size:15px">
                <p style="margin:0 0 16px 0">A new evaluation and review has been submitted for a business:</p>
                <table style="width:100%;border-collapse:collapse;margin:16px 0">
                    <tr>
                        <td style="padding:10px 12px;background:#f3f4f6;font-weight:700;width:140px;border:1px solid #e5e7eb">Business ID</td>
                        <td style="padding:10px 12px;border:1px solid #e5e7eb">{{businessId}}</td>
                    </tr>
                    <tr>
                        <td style="padding:10px 12px;background:#f3f4f6;font-weight:700;border:1px solid #e5e7eb">Rating</td>
                        <td style="padding:10px 12px;border:1px solid #e5e7eb;font-weight:bold;color:#f59e0b">{{stars}} / 5 Stars</td>
                    </tr>
                    <tr>
                        <td style="padding:10px 12px;background:#f3f4f6;font-weight:700;border:1px solid #e5e7eb;vertical-align:top">Feedback (FR)</td>
                        <td style="padding:10px 12px;border:1px solid #e5e7eb;white-space:pre-wrap">{{textFr}}</td>
                    </tr>
                    <tr>
                        <td style="padding:10px 12px;background:#f3f4f6;font-weight:700;border:1px solid #e5e7eb;vertical-align:top">Feedback (AR)</td>
                        <td style="padding:10px 12px;border:1px solid #e5e7eb;white-space:pre-wrap;text-align:right" dir="rtl">{{textAr}}</td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding:16px;text-align:center;color:#9ca3af;font-size:12px;border-top:1px solid #e5e7eb">
                {{app_name}} &copy; 2026
            </td>
        </tr>
    </table>
</body>
</html>